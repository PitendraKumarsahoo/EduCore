    function isValidAuditLog(data, instId) {
      return data.keys().hasAll(['institutionId', 'userUid', 'action', 'module', 'summary', 'createdAt'])
        && data.keys().hasOnly(['institutionId', 'userUid', 'userEmail', 'userName', 'userRole', 'action', 'module', 'recordId', 'summary', 'deviceInfo', 'createdAt'])
        && data.institutionId == instId
        && data.userUid == request.auth.uid
        && isValidOptStr(data, 'userEmail', 200)
        && isValidOptStr(data, 'userName', 120)
        && isValidOptStr(data, 'userRole', 60)
        && isNonEmptyStr(data.action, 60)
        && isNonEmptyStr(data.module, 80)
        && isValidOptStr(data, 'recordId', 128)
        && isNonEmptyStr(data.summary, 500)
        && isValidOptStr(data, 'deviceInfo', 200)
        && isValidStr(data.createdAt, 64);
    }

    // ==================== COLLECTION RULES ====================

    match /users/{uid} {
      allow get: if isVerified() && isValidId(uid) && (request.auth.uid == uid || isSuperAdmin());
      allow list: if isSuperAdmin();
      allow create: if isVerified() && isValidId(uid) && request.auth.uid == uid && isValidUserAccount(incoming(), uid);
      allow update: if isVerified() && isValidId(uid) && request.auth.uid == uid
        && isValidUserAccount(incoming(), uid)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'phone', 'photoUrl', 'activeInstitutionId', 'notificationPrefs', 'lastLoginAt', 'updatedAt']);
      allow delete: if false;
    }

    match /user_invites/{inviteId} {
      allow get: if isVerified() && isValidId(inviteId) && (
        isSuperAdmin() ||
        existing().email == request.auth.token.email.lower() ||
        isInstAdmin(existing().institutionId)
      );
      allow list: if isVerified() && (
        isSuperAdmin() ||
        existing().email == request.auth.token.email.lower() ||
        existing().createdByUid == request.auth.uid
      );
      allow create: if isVerified() && isValidId(inviteId)
        && isValidInvite(incoming())
        && incoming().createdByUid == request.auth.uid
        && isInstAdmin(incoming().institutionId);
      allow update: if isVerified() && isValidId(inviteId)
        && isValidInvite(incoming())
        && incoming().createdByUid == existing().createdByUid
        && incoming().institutionId == existing().institutionId
        && incoming().createdAt == existing().createdAt
        && (
          isInstAdmin(existing().institutionId) ||
          (existing().email == request.auth.token.email.lower() && existing().status == 'pending' && incoming().status == 'accepted'
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']))
        );
      allow delete: if isVerified() && isValidId(inviteId) && isInstAdmin(existing().institutionId);
    }

    match /institutions/{instId} {
      allow get: if isVerified() && isValidId(instId) && (isSuperAdmin() || isMember(instId) || existing().ownerUid == request.auth.uid);
      allow list: if isVerified() && (isSuperAdmin() || existing().ownerUid == request.auth.uid);
      allow create: if isVerified() && isValidId(instId)
        && isValidInstitution(incoming(), instId)
        && incoming().ownerUid == request.auth.uid;
      allow update: if isVerified() && isValidId(instId)
        && isValidInstitution(incoming(), instId)
        && incoming().id == existing().id
        && incoming().ownerUid == existing().ownerUid
        && incoming().createdAt == existing().createdAt
        && isInstAdmin(instId);
      allow delete: if isSuperAdmin() && isValidId(instId);

      // Memberships (Master Source of Truth for RBAC)
      match /members/{uid} {
        allow get: if isVerified() && isValidId(instId) && isValidId(uid) && (request.auth.uid == uid || isInstAdmin(instId));
        allow list: if isVerified() && (isInstAdmin(instId) || existing().uid == request.auth.uid);
        allow create: if isVerified() && isValidId(instId) && isValidId(uid)
          && isValidMember(incoming(), instId, uid)
          && (
            isInstAdmin(instId) ||
            // Bootstrap creator of the institution
            (request.auth.uid == uid && incoming().role == 'institution_admin'
              && get(/databases/$(database)/documents/institutions/$(instId)).data.ownerUid == request.auth.uid) ||
            // Super admin bootstrap
            (request.auth.uid == uid && isSuperAdmin() && incoming().role == 'super_admin') ||
            // User claiming an active pending invite matching their verified email and exact role
            (request.auth.uid == uid && incoming().email == request.auth.token.email.lower() && incoming().role != 'super_admin'
              && exists(invitePathForCurrentUser(instId))
              && get(invitePathForCurrentUser(instId)).data.status == 'pending'
              && incoming().role == get(invitePathForCurrentUser(instId)).data.role)
          );
        allow update: if isVerified() && isValidId(instId) && isValidId(uid)
          && isValidMember(incoming(), instId, uid)
          && incoming().uid == existing().uid
          && incoming().institutionId == existing().institutionId
          && incoming().createdAt == existing().createdAt
          && (
            isInstAdmin(instId) ||
            (request.auth.uid == uid && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt']))
          );
        allow delete: if isVerified() && isValidId(instId) && isValidId(uid) && isInstAdmin(instId);
      }

      // Institution-Scoped Invites Mirror (for admin listing without cross-collection list get())
      match /invites/{inviteId} {
        allow get: if isVerified() && isValidId(instId) && isValidId(inviteId) && (
          isInstAdmin(instId) || existing().email == request.auth.token.email.lower()
        );
        allow list: if isVerified() && isInstAdmin(instId);
        allow create: if isVerified() && isValidId(instId) && isValidId(inviteId)
          && isValidInvite(incoming())
          && incoming().institutionId == instId
          && incoming().createdByUid == request.auth.uid
          && isInstAdmin(instId);
        allow update: if isVerified() && isValidId(instId) && isValidId(inviteId)
          && isValidInvite(incoming())
          && incoming().institutionId == instId
          && incoming().createdByUid == existing().createdByUid
          && incoming().createdAt == existing().createdAt
          && (
            isInstAdmin(instId) ||
            (existing().email == request.auth.token.email.lower() && existing().status == 'pending' && incoming().status == 'accepted'
              && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']))
          );
        allow delete: if isVerified() && isValidId(instId) && isValidId(inviteId) && isInstAdmin(instId);
      }

      // Role Permission Matrix
      match /role_permissions/{roleKey} {
        allow get: if isVerified() && isValidId(instId) && isValidId(roleKey) && isMember(instId);
        allow list: if isVerified() && isMember(instId);
        allow create, update: if isVerified() && isValidId(instId) && isValidId(roleKey)
          && isValidRoleMatrix(incoming(), instId)
          && isInstAdmin(instId);
        allow delete: if isVerified() && isValidId(instId) && isValidId(roleKey) && isInstAdmin(instId);
      }

      // Academic Years
      match /academic_years/{yearId} {
        allow get: if isVerified() && isValidId(instId) && isValidId(yearId) && isMember(instId);
        allow list: if isVerified() && isMember(instId);
        allow create, update: if isVerified() && isValidId(instId) && isValidId(yearId)
          && isValidAcademicYear(incoming(), instId)
          && isInstAdmin(instId);
        allow delete: if isVerified() && isValidId(instId) && isValidId(yearId) && isInstAdmin(instId);
      }

      // Departments
      match /departments/{deptId} {
        allow get: if isVerified() && isValidId(instId) && isValidId(deptId) && isMember(instId);
        allow list: if isVerified() && isMember(instId);
        allow create, update: if isVerified() && isValidId(instId) && isValidId(deptId)
          && isValidDepartment(incoming(), instId)
          && isInstAdmin(instId);
        allow delete: if isVerified() && isValidId(instId) && isValidId(deptId) && isInstAdmin(instId);
      }

      // Programs
      match /programs/{programId} {
        allow get: if isVerified() && isValidId(instId) && isValidId(programId) && isMember(instId);
        allow list: if isVerified() && isMember(instId);
        allow create, update: if isVerified() && isValidId(instId) && isValidId(programId)
          && isValidProgram(incoming(), instId)
          && isAcademicManager(instId);
        allow delete: if isVerified() && isValidId(instId) && isValidId(programId) && isInstAdmin(instId);
      }

      // Classes
      match /classes/{classId} {
        allow get: if isVerified() && isValidId(instId) && isValidId(classId) && isMember(instId);
        allow list: if isVerified() && isMember(instId);
        allow create, update: if isVerified() && isValidId(instId) && isValidId(classId)
          && isValidClass(incoming(), instId)
          && isAcademicManager(instId);
        allow delete: if isVerified() && isValidId(instId) && isValidId(classId) && isInstAdmin(instId);
      }

      // Sections
      match /sections/{sectionId} {
        allow get: if isVerified() && isValidId(instId) && isValidId(sectionId) && isMember(instId);
        allow list: if isVerified() && isMember(instId);
        allow create, update: if isVerified() && isValidId(instId) && isValidId(sectionId)
          && isValidSection(incoming(), instId)
          && isAcademicManager(instId);
        allow delete: if isVerified() && isValidId(instId) && isValidId(sectionId) && isInstAdmin(instId);
      }

      // Subjects
      match /subjects/{subjectId} {
        allow get: if isVerified() && isValidId(instId) && isValidId(subjectId) && isMember(instId);
        allow list: if isVerified() && isMember(instId);
        allow create, update: if isVerified() && isValidId(instId) && isValidId(subjectId)
          && isValidSubject(incoming(), instId)
          && isAcademicManager(instId);
        allow delete: if isVerified() && isValidId(instId) && isValidId(subjectId) && isInstAdmin(instId);
      }

      // Admissions
      match /admissions/{admissionId} {
        allow get: if isVerified() && isValidId(instId) && isValidId(admissionId) && isStaffOrAdmin(instId);
        allow list: if isVerified() && isStaffOrAdmin(instId);
        allow create, update: if isVerified() && isValidId(instId) && isValidId(admissionId)
          && isValidAdmission(incoming(), instId)
          && (isInstAdmin(instId) || (isMember(instId) && memberDoc(instId).role == 'receptionist'));
        allow delete: if isVerified() && isValidId(instId) && isValidId(admissionId) && isInstAdmin(instId);
      }

      // Students (PII restricted to Staff/Admin, owning Student, or linked Parent)
      match /students/{studentId} {
        allow get: if isVerified() && isValidId(instId) && isValidId(studentId) && (
          isStaffOrAdmin(instId) ||
          existing().userUid == request.auth.uid ||
          existing().parentUid == request.auth.uid
        );
        allow list: if isVerified() && (
          isStaffOrAdmin(instId) ||
          existing().userUid == request.auth.uid ||
          existing().parentUid == request.auth.uid
        );
        allow create: if isVerified() && isValidId(instId) && isValidId(studentId)
          && isValidStudent(incoming(), instId)
          && (isInstAdmin(instId) || (isMember(instId) && memberDoc(instId).role == 'receptionist'));
        allow update: if isVerified() && isValidId(instId) && isValidId(studentId)
          && isValidStudent(incoming(), instId)
          && incoming().createdAt == existing().createdAt
          && (isInstAdmin(instId) || (isMember(instId) && memberDoc(instId).role in ['receptionist', 'hod']));
        allow delete: if isVerified() && isValidId(instId) && isValidId(studentId) && isInstAdmin(instId);
      }

      // Employees (Faculty & Staff)
      match /employees/{employeeId} {
        allow get: if isVerified() && isValidId(instId) && isValidId(employeeId) && (
          isStaffOrAdmin(instId) || existing().userUid == request.auth.uid
        );
        allow list: if isVerified() && (
          isStaffOrAdmin(instId) || existing().userUid == request.auth.uid
        );
        allow create, update: if isVerified() && isValidId(instId) && isValidId(employeeId)
