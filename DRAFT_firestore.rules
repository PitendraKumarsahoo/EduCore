    function isValidNotification(data, instId) {
      return data.keys().hasAll(['institutionId', 'recipientUid', 'type', 'title', 'message', 'isRead', 'createdAt'])
        && data.keys().hasOnly(['institutionId', 'recipientUid', 'type', 'title', 'message', 'isRead', 'linkModule', 'createdAt'])
        && data.institutionId == instId
        && isNonEmptyStr(data.recipientUid, 128)
        && data.type in ['fee_due', 'payment', 'attendance', 'exam', 'result', 'assignment', 'notice', 'leave', 'announcement']
        && isNonEmptyStr(data.title, 180)
        && isNonEmptyStr(data.message, 500)
        && data.isRead is bool
        && isValidOptStr(data, 'linkModule', 60)
        && isValidStr(data.createdAt, 64);
