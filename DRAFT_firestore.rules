        allow delete: if isVerified() && isValidId(instId) && isValidId(notifId) && existing().recipientUid == request.auth.uid;
      }

      // Messages
      match /messages/{msgId} {
        allow get: if isVerified() && isValidId(instId) && isValidId(msgId) && (
          existing().senderUid == request.auth.uid || existing().recipientUid == request.auth.uid || isInstAdmin(instId)
        );
        allow list: if isVerified() && (
          existing().senderUid == request.auth.uid || existing().recipientUid == request.auth.uid || isInstAdmin(instId)
        );
        allow create: if isVerified() && isValidId(instId) && isValidId(msgId)
          && isValidMessage(incoming(), instId)
          && incoming().senderUid == request.auth.uid
          && isMember(instId);
        allow update: if isVerified() && isValidId(instId) && isValidId(msgId)
          && isValidMessage(incoming(), instId)
          && existing().recipientUid == request.auth.uid
          && incoming().diff(existing()).affectedKeys().hasOnly(['isRead']);
        allow delete: if false;
      }

      // Audit Logs (Append-Only)
      match /audit_logs/{logId} {
        allow get: if isVerified() && isValidId(instId) && isValidId(logId) && isInstAdmin(instId);
        allow list: if isVerified() && isInstAdmin(instId);
        allow create: if isVerified() && isValidId(instId) && isValidId(logId)
          && isValidAuditLog(incoming(), instId)
          && (isMember(instId) || isSuperAdmin());
        allow update, delete: if false;
      }
    }
  }
}
