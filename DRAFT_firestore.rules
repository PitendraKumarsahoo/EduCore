      }

      // Notifications
      match /notifications/{notifId} {
        allow get: if isVerified() && isValidId(instId) && isValidId(notifId) && (
          existing().recipientUid == request.auth.uid || isInstAdmin(instId)
        );
        allow list: if isVerified() && (
          existing().recipientUid == request.auth.uid || isInstAdmin(instId)
        );
        allow create: if isVerified() && isValidId(instId) && isValidId(notifId)
