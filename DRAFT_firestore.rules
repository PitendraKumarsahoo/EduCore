    function isValidDocument(data, instId) {
      return data.keys().hasAll(['institutionId', 'ownerType', 'ownerId', 'documentType', 'title', 'fileName', 'uploadedByUid', 'createdAt'])
        && data.keys().hasOnly(['institutionId', 'ownerType', 'ownerId', 'ownerName', 'documentType', 'title', 'fileName', 'mimeType', 'sizeBytes', 'dataUrl', 'verified', 'uploadedByUid', 'createdAt'])
        && data.institutionId == instId
        && data.ownerType in ['student', 'employee', 'institution']
        && isNonEmptyStr(data.ownerId, 128)
        && isValidOptStr(data, 'ownerName', 160)
