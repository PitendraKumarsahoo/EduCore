          && isInstAdmin(instId);
        allow delete: if isVerified() && isValidId(instId) && isValidId(employeeId) && isInstAdmin(instId);
      }

      // Attendance
      match /attendance/{attendanceId} {
        allow get: if isVerified() && isValidId(instId) && isValidId(attendanceId) && (
          isStaffOrAdmin(instId) ||
          existing().studentUserUid == request.auth.uid ||
          existing().parentUserUid == request.auth.uid
        );
        allow list: if isVerified() && (
          isStaffOrAdmin(instId) ||
          existing().studentUserUid == request.auth.uid ||
          existing().parentUserUid == request.auth.uid
        );
        allow create, update: if isVerified() && isValidId(instId) && isValidId(attendanceId)
          && isValidAttendance(incoming(), instId)
          && incoming().markedByUid == request.auth.uid
          && isTeacherOrAbove(instId);
        allow delete: if isVerified() && isValidId(instId) && isValidId(attendanceId) && isInstAdmin(instId);
      }

      // Timetables
      match /timetables/{slotId} {
        allow get: if isVerified() && isValidId(instId) && isValidId(slotId) && isMember(instId);
        allow list: if isVerified() && isMember(instId);
        allow create, update: if isVerified() && isValidId(instId) && isValidId(slotId)
          && isValidTimetableSlot(incoming(), instId)
          && isAcademicManager(instId);
        allow delete: if isVerified() && isValidId(instId) && isValidId(slotId) && isAcademicManager(instId);
      }

      // Examinations
      match /examinations/{examId} {
        allow get: if isVerified() && isValidId(instId) && isValidId(examId) && isMember(instId);
        allow list: if isVerified() && isMember(instId);
        allow create, update: if isVerified() && isValidId(instId) && isValidId(examId)
          && isValidExam(incoming(), instId)
          && isAcademicManager(instId);
        allow delete: if isVerified() && isValidId(instId) && isValidId(examId) && isInstAdmin(instId);
      }

      // Marks
      match /marks/{markId} {
        allow get: if isVerified() && isValidId(instId) && isValidId(markId) && (
          isTeacherOrAbove(instId) ||
          (existing().isPublished == true && (existing().studentUserUid == request.auth.uid || existing().parentUserUid == request.auth.uid))
        );
        allow list: if isVerified() && (
          isTeacherOrAbove(instId) ||
          (existing().isPublished == true && (existing().studentUserUid == request.auth.uid || existing().parentUserUid == request.auth.uid))
        );
        allow create, update: if isVerified() && isValidId(instId) && isValidId(markId)
          && isValidMark(incoming(), instId)
          && incoming().enteredByUid == request.auth.uid
          && isTeacherOrAbove(instId);
        allow delete: if isVerified() && isValidId(instId) && isValidId(markId) && isInstAdmin(instId);
      }

      // Fee Categories & Structures
      match /fee_categories/{catId} {
        allow get: if isVerified() && isValidId(instId) && isValidId(catId) && isMember(instId);
        allow list: if isVerified() && isMember(instId);
        allow create, update: if isVerified() && isValidId(instId) && isValidId(catId)
          && isValidFeeCategory(incoming(), instId)
          && isAccountantOrAdmin(instId);
        allow delete: if isVerified() && isValidId(instId) && isValidId(catId) && isInstAdmin(instId);
      }

      match /fee_structures/{structureId} {
        allow get: if isVerified() && isValidId(instId) && isValidId(structureId) && isMember(instId);
        allow list: if isVerified() && isMember(instId);
        allow create, update: if isVerified() && isValidId(instId) && isValidId(structureId)
          && isValidFeeStructure(incoming(), instId)
          && isAccountantOrAdmin(instId);
        allow delete: if isVerified() && isValidId(instId) && isValidId(structureId) && isInstAdmin(instId);
      }

      // Student Fees (isolated to Accountant/Admin, Student, or linked Parent)
      match /student_fees/{feeId} {
        allow get: if isVerified() && isValidId(instId) && isValidId(feeId) && (
          isAccountantOrAdmin(instId) ||
          existing().studentUserUid == request.auth.uid ||
          existing().parentUserUid == request.auth.uid
        );
        allow list: if isVerified() && (
          isAccountantOrAdmin(instId) ||
          existing().studentUserUid == request.auth.uid ||
          existing().parentUserUid == request.auth.uid
        );
        allow create, update: if isVerified() && isValidId(instId) && isValidId(feeId)
          && isValidStudentFee(incoming(), instId)
          && isAccountantOrAdmin(instId);
        allow delete: if false;
      }

      // Payments (Immutable receipts, refund-only updates, isolated to Accountant/Admin/Owner/Parent)
      match /payments/{paymentId} {
        allow get: if isVerified() && isValidId(instId) && isValidId(paymentId) && (
          isAccountantOrAdmin(instId) ||
          existing().studentUserUid == request.auth.uid ||
          existing().parentUserUid == request.auth.uid
        );
        allow list: if isVerified() && (
          isAccountantOrAdmin(instId) ||
          existing().studentUserUid == request.auth.uid ||
          existing().parentUserUid == request.auth.uid
        );
        allow create: if isVerified() && isValidId(instId) && isValidId(paymentId)
          && isValidPayment(incoming(), instId)
          && incoming().recordedByUid == request.auth.uid
          && isAccountantOrAdmin(instId);
        allow update: if isVerified() && isValidId(instId) && isValidId(paymentId)
          && isValidPayment(incoming(), instId)
          && isAccountantOrAdmin(instId)
          && existing().gatewayStatus != 'refunded'
          && incoming().gatewayStatus == 'refunded'
          && incoming().diff(existing()).affectedKeys().hasOnly(['gatewayStatus', 'refundedAt', 'refundReason']);
        allow delete: if false;
      }

      // Accounting Entries
      match /accounting_entries/{entryId} {
        allow get: if isVerified() && isValidId(instId) && isValidId(entryId) && isAccountantOrAdmin(instId);
        allow list: if isVerified() && isAccountantOrAdmin(instId);
        allow create: if isVerified() && isValidId(instId) && isValidId(entryId)
          && isValidAccountingEntry(incoming(), instId)
          && incoming().recordedByUid == request.auth.uid
          && isAccountantOrAdmin(instId);
        allow update, delete: if false;
      }

      // Library
      match /library_books/{bookId} {
        allow get: if isVerified() && isValidId(instId) && isValidId(bookId) && isMember(instId);
        allow list: if isVerified() && isMember(instId);
        allow create, update: if isVerified() && isValidId(instId) && isValidId(bookId)
          && isValidLibraryBook(incoming(), instId)
          && isLibrarianOrAdmin(instId);
        allow delete: if isVerified() && isValidId(instId) && isValidId(bookId) && isInstAdmin(instId);
      }

      match /library_transactions/{txId} {
        allow get: if isVerified() && isValidId(instId) && isValidId(txId) && (
          isLibrarianOrAdmin(instId) || existing().borrowerUid == request.auth.uid
        );
        allow list: if isVerified() && (
          isLibrarianOrAdmin(instId) || existing().borrowerUid == request.auth.uid
        );
        allow create, update: if isVerified() && isValidId(instId) && isValidId(txId)
          && isValidLibraryTx(incoming(), instId)
          && isLibrarianOrAdmin(instId);
        allow delete: if false;
      }

      // Transport
      match /transport_routes/{routeId} {
        allow get: if isVerified() && isValidId(instId) && isValidId(routeId) && isMember(instId);
        allow list: if isVerified() && isMember(instId);
        allow create, update: if isVerified() && isValidId(instId) && isValidId(routeId)
          && isValidTransportRoute(incoming(), instId)
          && isInstAdmin(instId);
        allow delete: if isVerified() && isValidId(instId) && isValidId(routeId) && isInstAdmin(instId);
      }

      // Hostels & Allocations
      match /hostels/{hostelId} {
        allow get: if isVerified() && isValidId(instId) && isValidId(hostelId) && isMember(instId);
        allow list: if isVerified() && isMember(instId);
        allow create, update: if isVerified() && isValidId(instId) && isValidId(hostelId)
          && isValidHostel(incoming(), instId)
          && isInstAdmin(instId);
        allow delete: if isVerified() && isValidId(instId) && isValidId(hostelId) && isInstAdmin(instId);
      }

      match /hostel_allocations/{allocId} {
        allow get: if isVerified() && isValidId(instId) && isValidId(allocId) && isMember(instId);
        allow list: if isVerified() && isMember(instId);
        allow create, update: if isVerified() && isValidId(instId) && isValidId(allocId)
          && isValidHostelAlloc(incoming(), instId)
          && isInstAdmin(instId);
        allow delete: if isVerified() && isValidId(instId) && isValidId(allocId) && isInstAdmin(instId);
      }

      // Assignments & Submissions
      match /assignments/{assignmentId} {
        allow get: if isVerified() && isValidId(instId) && isValidId(assignmentId) && isMember(instId);
        allow list: if isVerified() && isMember(instId);
        allow create, update: if isVerified() && isValidId(instId) && isValidId(assignmentId)
          && isValidAssignment(incoming(), instId)
          && isTeacherOrAbove(instId);
        allow delete: if isVerified() && isValidId(instId) && isValidId(assignmentId) && isTeacherOrAbove(instId);
      }

      match /assignment_submissions/{subId} {
        allow get: if isVerified() && isValidId(instId) && isValidId(subId) && (
          isTeacherOrAbove(instId) || existing().studentUid == request.auth.uid
        );
        allow list: if isVerified() && (
          isTeacherOrAbove(instId) || existing().studentUid == request.auth.uid
        );
        allow create: if isVerified() && isValidId(instId) && isValidId(subId)
          && isValidSubmission(incoming(), instId)
          && (isTeacherOrAbove(instId) || incoming().studentUid == request.auth.uid);
        allow update: if isVerified() && isValidId(instId) && isValidId(subId)
          && isValidSubmission(incoming(), instId)
          && (
            isTeacherOrAbove(instId) ||
            (existing().studentUid == request.auth.uid && existing().status != 'graded'
              && incoming().diff(existing()).affectedKeys().hasOnly(['notes', 'attachmentName', 'attachmentDataUrl', 'submittedAt', 'updatedAt']))
          );
        allow delete: if isVerified() && isValidId(instId) && isValidId(subId) && isInstAdmin(instId);
      }

      // Leave Requests
      match /leave_requests/{leaveId} {
        allow get: if isVerified() && isValidId(instId) && isValidId(leaveId) && (
