        allow list: if isVerified() && (
          isInstAdmin(instId) || isAcademicManager(instId) || existing().applicantUid == request.auth.uid
        );
        allow create: if isVerified() && isValidId(instId) && isValidId(leaveId)
          && isValidLeave(incoming(), instId)
          && incoming().applicantUid == request.auth.uid
          && incoming().status == 'pending'
          && isMember(instId);
        allow update: if isVerified() && isValidId(instId) && isValidId(leaveId)
          && isValidLeave(incoming(), instId)
          && (
            isAcademicManager(instId) ||
            (existing().applicantUid == request.auth.uid && existing().status == 'pending'
              && incoming().status == 'pending'
              && incoming().diff(existing()).affectedKeys().hasOnly(['leaveType', 'startDate', 'endDate', 'reason', 'updatedAt']))
          );
        allow delete: if isVerified() && isValidId(instId) && isValidId(leaveId) && isInstAdmin(instId);
      }

      // Notices
      match /notices/{noticeId} {
        allow get: if isVerified() && isValidId(instId) && isValidId(noticeId) && (
