rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // ==================== PRIMITIVES & HELPERS ====================
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isSuperAdmin() {
      return isVerified() && request.auth.token.email == 'pitendrakumarsahoo84@gmail.com';
    }

    function isValidStr(val, maxLen) {
      return val is string && val.size() <= maxLen;
    }

    function isNonEmptyStr(val, maxLen) {
      return val is string && val.size() >= 1 && val.size() <= maxLen;
    }

    function isValidOptStr(data, field, maxLen) {
      return !(field in data) || (data[field] is string && data[field].size() <= maxLen);
    }

    function isValidOptNum(data, field) {
      return !(field in data) || (data[field] is number);
    }

    function isValidOptBool(data, field) {
      return !(field in data) || (data[field] is bool);
    }

    function isValidRole(role) {
      return role in [
        'super_admin',
        'institution_admin',
        'principal',
        'vice_principal',
        'hod',
        'teacher',
        'accountant',
        'librarian',
        'receptionist',
        'student',
        'parent'
      ];
    }

    function isMember(instId) {
      return isVerified()
        && exists(/databases/$(database)/documents/institutions/$(instId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/institutions/$(instId)/members/$(request.auth.uid)).data.status == 'active';
    }

    function memberDoc(instId) {
      return get(/databases/$(database)/documents/institutions/$(instId)/members/$(request.auth.uid)).data;
    }

    function isInstAdmin(instId) {
      return isSuperAdmin() || (
        isMember(instId) && memberDoc(instId).role in ['super_admin', 'institution_admin', 'principal', 'vice_principal']
      );
    }

    function isAcademicManager(instId) {
      return isInstAdmin(instId) || (
        isMember(instId) && memberDoc(instId).role == 'hod'
      );
    }

    function isTeacherOrAbove(instId) {
      return isAcademicManager(instId) || (
        isMember(instId) && memberDoc(instId).role == 'teacher'
      );
    }

    function isAccountantOrAdmin(instId) {
      return isInstAdmin(instId) || (
        isMember(instId) && memberDoc(instId).role == 'accountant'
      );
    }

    function isLibrarianOrAdmin(instId) {
      return isInstAdmin(instId) || (
        isMember(instId) && memberDoc(instId).role == 'librarian'
      );
    }

    function isStaffOrAdmin(instId) {
      return isInstAdmin(instId) || (
        isMember(instId) && memberDoc(instId).role in ['hod', 'teacher', 'accountant', 'librarian', 'receptionist']
      );
    }

    function invitePathForCurrentUser(instId) {
      return /databases/$(database)/documents/user_invites/$(instId + '_' + request.auth.token.email.lower().replace('[^a-z0-9]', '_'));
    }

    // ==================== VALIDATION BLUEPRINTS ====================
    function isValidUserAccount(data, uid) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'phone', 'photoUrl', 'activeInstitutionId', 'notificationPrefs', 'lastLoginAt', 'createdAt', 'updatedAt'])
        && data.uid == uid
        && isValidStr(data.email, 200)
        && isNonEmptyStr(data.displayName, 120)
        && isValidOptStr(data, 'phone', 30)
        && isValidOptStr(data, 'photoUrl', 400000)
        && isValidOptStr(data, 'activeInstitutionId', 128)
        && (!( 'notificationPrefs' in data) || data.notificationPrefs is map)
        && isValidOptStr(data, 'lastLoginAt', 64)
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidInvite(data) {
      return data.keys().hasAll(['email', 'institutionId', 'role', 'status', 'createdByUid', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['email', 'institutionId', 'institutionName', 'role', 'displayName', 'linkedStudentIds', 'linkedEmployeeId', 'status', 'createdByUid', 'createdAt', 'updatedAt'])
        && isNonEmptyStr(data.email, 200)
        && isValidId(data.institutionId)
        && isValidOptStr(data, 'institutionName', 160)
        && isValidRole(data.role)
        && isValidOptStr(data, 'displayName', 120)
        && (!( 'linkedStudentIds' in data) || (data.linkedStudentIds is list && data.linkedStudentIds.size() <= 10))
        && isValidOptStr(data, 'linkedEmployeeId', 128)
        && data.status in ['pending', 'accepted', 'revoked']
        && isNonEmptyStr(data.createdByUid, 128)
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidInstitution(data, instId) {
      return data.keys().hasAll(['id', 'name', 'type', 'currency', 'timezone', 'ownerUid', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'name', 'type', 'code', 'logoUrl', 'address', 'phone', 'email', 'website', 'timezone', 'currency', 'currentAcademicYearId', 'workingDays', 'gradingScale', 'attendanceRules', 'feeRules', 'staffCategories', 'documentTypes', 'setupCompleted', 'setupStep', 'ownerUid', 'createdAt', 'updatedAt'])
        && data.id == instId
        && isNonEmptyStr(data.name, 160)
        && data.type in ['school', 'college', 'university', 'k12_and_college']
        && isValidOptStr(data, 'code', 32)
        && isValidOptStr(data, 'logoUrl', 400000)
        && isValidOptStr(data, 'address', 400)
        && isValidOptStr(data, 'phone', 40)
        && isValidOptStr(data, 'email', 200)
        && isValidOptStr(data, 'website', 200)
        && isNonEmptyStr(data.timezone, 80)
        && isNonEmptyStr(data.currency, 10)
        && isValidOptStr(data, 'currentAcademicYearId', 128)
        && (!( 'workingDays' in data) || (data.workingDays is list && data.workingDays.size() <= 7))
        && (!( 'gradingScale' in data) || (data.gradingScale is list && data.gradingScale.size() <= 15))
        && (!( 'attendanceRules' in data) || data.attendanceRules is map)
        && (!( 'feeRules' in data) || data.feeRules is map)
        && (!( 'staffCategories' in data) || (data.staffCategories is list && data.staffCategories.size() <= 30))
        && (!( 'documentTypes' in data) || (data.documentTypes is list && data.documentTypes.size() <= 30))
        && isValidOptBool(data, 'setupCompleted')
        && isValidOptNum(data, 'setupStep')
        && isNonEmptyStr(data.ownerUid, 128)
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidMember(data, instId, uid) {
      return data.keys().hasAll(['uid', 'institutionId', 'email', 'role', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'institutionId', 'email', 'displayName', 'role', 'permissions', 'linkedStudentIds', 'linkedEmployeeId', 'assignedClassIds', 'assignedSubjectIds', 'status', 'createdAt', 'updatedAt'])
        && data.uid == uid
        && data.institutionId == instId
        && isNonEmptyStr(data.email, 200)
        && isValidOptStr(data, 'displayName', 120)
        && isValidRole(data.role)
        && (!( 'permissions' in data) || data.permissions is map)
        && (!( 'linkedStudentIds' in data) || (data.linkedStudentIds is list && data.linkedStudentIds.size() <= 10))
        && isValidOptStr(data, 'linkedEmployeeId', 128)
        && (!( 'assignedClassIds' in data) || (data.assignedClassIds is list && data.assignedClassIds.size() <= 30))
        && (!( 'assignedSubjectIds' in data) || (data.assignedSubjectIds is list && data.assignedSubjectIds.size() <= 30))
        && data.status in ['active', 'inactive']
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidRoleMatrix(data, instId) {
      return data.keys().hasAll(['role', 'institutionId', 'modules', 'updatedAt'])
        && data.keys().hasOnly(['role', 'institutionId', 'modules', 'updatedAt'])
        && data.institutionId == instId
        && isValidRole(data.role)
        && data.modules is map
        && data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidAcademicYear(data, instId) {
      return data.keys().hasAll(['institutionId', 'name', 'startDate', 'endDate', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['institutionId', 'name', 'startDate', 'endDate', 'isCurrent', 'status', 'createdAt', 'updatedAt'])
        && data.institutionId == instId
        && isNonEmptyStr(data.name, 64)
        && isNonEmptyStr(data.startDate, 20)
        && isNonEmptyStr(data.endDate, 20)
        && isValidOptBool(data, 'isCurrent')
        && data.status in ['active', 'archived']
        && isValidStr(data.createdAt, 64)
        && isValidStr(data.updatedAt, 64);
    }

    function isValidDepartment(data, instId) {
      return data.keys().hasAll(['institutionId', 'name', 'code', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['institutionId', 'name', 'code', 'hodEmployeeId', 'hodName', 'description', 'status', 'createdAt', 'updatedAt'])
        && data.institutionId == instId
        && isNonEmptyStr(data.name, 120)
        && isNonEmptyStr(data.code, 32)
        && isValidOptStr(data, 'hodEmployeeId', 128)
        && isValidOptStr(data, 'hodName', 120)
        && isValidOptStr(data, 'description', 500)
        && data.status in ['active', 'inactive']
        && isValidStr(data.createdAt, 64)
        && isValidStr(data.updatedAt, 64);
    }

    function isValidProgram(data, instId) {
      return data.keys().hasAll(['institutionId', 'name', 'code', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['institutionId', 'name', 'code', 'degreeType', 'departmentId', 'durationYears', 'semesterCount', 'creditStructure', 'status', 'createdAt', 'updatedAt'])
        && data.institutionId == instId
        && isNonEmptyStr(data.name, 140)
        && isNonEmptyStr(data.code, 32)
        && isValidOptStr(data, 'degreeType', 80)
        && isValidOptStr(data, 'departmentId', 128)
        && isValidOptNum(data, 'durationYears')
        && isValidOptNum(data, 'semesterCount')
        && isValidOptStr(data, 'creditStructure', 160)
        && data.status in ['active', 'inactive']
        && isValidStr(data.createdAt, 64)
        && isValidStr(data.updatedAt, 64);
    }

    function isValidClass(data, instId) {
      return data.keys().hasAll(['institutionId', 'name', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['institutionId', 'academicYearId', 'departmentId', 'programId', 'name', 'code', 'semesterNumber', 'levelType', 'capacity', 'status', 'createdAt', 'updatedAt'])
        && data.institutionId == instId
        && isValidOptStr(data, 'academicYearId', 128)
        && isValidOptStr(data, 'departmentId', 128)
        && isValidOptStr(data, 'programId', 128)
        && isNonEmptyStr(data.name, 100)
        && isValidOptStr(data, 'code', 32)
        && isValidOptNum(data, 'semesterNumber')
        && (!( 'levelType' in data) || data.levelType in ['school_class', 'college_semester'])
        && isValidOptNum(data, 'capacity')
        && data.status in ['active', 'inactive']
        && isValidStr(data.createdAt, 64)
        && isValidStr(data.updatedAt, 64);
    }

    function isValidSection(data, instId) {
      return data.keys().hasAll(['institutionId', 'classId', 'name', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['institutionId', 'academicYearId', 'classId', 'name', 'batchName', 'roomNumber', 'capacity', 'classTeacherId', 'status', 'createdAt', 'updatedAt'])
        && data.institutionId == instId
        && isValidOptStr(data, 'academicYearId', 128)
        && isNonEmptyStr(data.classId, 128)
        && isNonEmptyStr(data.name, 80)
        && isValidOptStr(data, 'batchName', 80)
        && isValidOptStr(data, 'roomNumber', 40)
        && isValidOptNum(data, 'capacity')
        && isValidOptStr(data, 'classTeacherId', 128)
        && data.status in ['active', 'inactive']
        && isValidStr(data.createdAt, 64)
        && isValidStr(data.updatedAt, 64);
    }

    function isValidSubject(data, instId) {
      return data.keys().hasAll(['institutionId', 'code', 'name', 'maxMarks', 'passingMarks', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['institutionId', 'code', 'name', 'departmentId', 'programId', 'classId', 'sectionId', 'credits', 'subjectType', 'maxMarks', 'passingMarks', 'facultyId', 'facultyName', 'status', 'createdAt', 'updatedAt'])
        && data.institutionId == instId
        && isNonEmptyStr(data.code, 32)
        && isNonEmptyStr(data.name, 140)
        && isValidOptStr(data, 'departmentId', 128)
        && isValidOptStr(data, 'programId', 128)
        && isValidOptStr(data, 'classId', 128)
        && isValidOptStr(data, 'sectionId', 128)
        && isValidOptNum(data, 'credits')
        && (!( 'subjectType' in data) || data.subjectType in ['theory', 'practical', 'both'])
        && data.maxMarks is number && data.maxMarks > 0 && data.maxMarks <= 1000
        && data.passingMarks is number && data.passingMarks >= 0 && data.passingMarks <= data.maxMarks
        && isValidOptStr(data, 'facultyId', 128)
        && isValidOptStr(data, 'facultyName', 120)
        && data.status in ['active', 'inactive']
        && isValidStr(data.createdAt, 64)
        && isValidStr(data.updatedAt, 64);
    }

    function isValidAdmission(data, instId) {
      return data.keys().hasAll(['institutionId', 'applicationNumber', 'firstName', 'lastName', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['institutionId', 'applicationNumber', 'academicYearId', 'firstName', 'middleName', 'lastName', 'dob', 'gender', 'email', 'phone', 'address', 'previousInstitution', 'previousScore', 'targetProgramId', 'targetClassId', 'targetSectionId', 'guardianName', 'guardianRelation', 'guardianPhone', 'guardianEmail', 'interviewDate', 'interviewNotes', 'verificationStatus', 'status', 'enrolledStudentId', 'remarks', 'createdAt', 'updatedAt'])
        && data.institutionId == instId
        && isNonEmptyStr(data.applicationNumber, 48)
        && isValidOptStr(data, 'academicYearId', 128)
        && isNonEmptyStr(data.firstName, 80)
        && isValidOptStr(data, 'middleName', 80)
        && isNonEmptyStr(data.lastName, 80)
        && isValidOptStr(data, 'dob', 20)
        && isValidOptStr(data, 'gender', 24)
        && isValidOptStr(data, 'email', 200)
        && isValidOptStr(data, 'phone', 30)
        && isValidOptStr(data, 'address', 400)
        && isValidOptStr(data, 'previousInstitution', 160)
        && isValidOptStr(data, 'previousScore', 40)
        && isValidOptStr(data, 'targetProgramId', 128)
        && isValidOptStr(data, 'targetClassId', 128)
        && isValidOptStr(data, 'targetSectionId', 128)
        && isValidOptStr(data, 'guardianName', 120)
        && isValidOptStr(data, 'guardianRelation', 60)
        && isValidOptStr(data, 'guardianPhone', 30)
        && isValidOptStr(data, 'guardianEmail', 200)
        && isValidOptStr(data, 'interviewDate', 32)
        && isValidOptStr(data, 'interviewNotes', 500)
        && (!( 'verificationStatus' in data) || data.verificationStatus in ['pending', 'verified', 'flagged'])
        && data.status in ['draft', 'submitted', 'under_review', 'documents_pending', 'approved', 'rejected', 'enrolled']
        && isValidOptStr(data, 'enrolledStudentId', 128)
        && isValidOptStr(data, 'remarks', 500)
        && isValidStr(data.createdAt, 64)
        && isValidStr(data.updatedAt, 64);
    }

    function isValidStudent(data, instId) {
      return data.keys().hasAll(['institutionId', 'studentCode', 'firstName', 'lastName', 'status', 'isDeleted', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['institutionId', 'studentCode', 'admissionNumber', 'rollNumber', 'firstName', 'middleName', 'lastName', 'dob', 'gender', 'bloodGroup', 'phone', 'email', 'address', 'city', 'state', 'country', 'postalCode', 'photoUrl', 'admissionDate', 'academicYearId', 'departmentId', 'programId', 'classId', 'sectionId', 'status', 'previousInstitution', 'transferInfo', 'guardianName', 'guardianRelation', 'guardianPhone', 'guardianEmail', 'emergencyContactName', 'emergencyContactPhone', 'userUid', 'parentUid', 'disciplineRecords', 'isDeleted', 'createdAt', 'updatedAt'])
        && data.institutionId == instId
        && isNonEmptyStr(data.studentCode, 48)
        && isValidOptStr(data, 'admissionNumber', 48)
        && isValidOptStr(data, 'rollNumber', 48)
        && isNonEmptyStr(data.firstName, 80)
        && isValidOptStr(data, 'middleName', 80)
        && isNonEmptyStr(data.lastName, 80)
        && isValidOptStr(data, 'dob', 20)
        && isValidOptStr(data, 'gender', 24)
        && isValidOptStr(data, 'bloodGroup', 12)
        && isValidOptStr(data, 'phone', 30)
        && isValidOptStr(data, 'email', 200)
        && isValidOptStr(data, 'address', 400)
        && isValidOptStr(data, 'city', 80)
        && isValidOptStr(data, 'state', 80)
        && isValidOptStr(data, 'country', 80)
        && isValidOptStr(data, 'postalCode', 24)
        && isValidOptStr(data, 'photoUrl', 400000)
        && isValidOptStr(data, 'admissionDate', 20)
        && isValidOptStr(data, 'academicYearId', 128)
        && isValidOptStr(data, 'departmentId', 128)
        && isValidOptStr(data, 'programId', 128)
        && isValidOptStr(data, 'classId', 128)
        && isValidOptStr(data, 'sectionId', 128)
        && data.status in ['active', 'inactive', 'graduated', 'transferred', 'suspended', 'withdrawn']
        && isValidOptStr(data, 'previousInstitution', 160)
        && isValidOptStr(data, 'transferInfo', 300)
        && isValidOptStr(data, 'guardianName', 120)
        && isValidOptStr(data, 'guardianRelation', 60)
        && isValidOptStr(data, 'guardianPhone', 30)
        && isValidOptStr(data, 'guardianEmail', 200)
        && isValidOptStr(data, 'emergencyContactName', 120)
        && isValidOptStr(data, 'emergencyContactPhone', 30)
        && isValidOptStr(data, 'userUid', 128)
        && isValidOptStr(data, 'parentUid', 128)
        && (!( 'disciplineRecords' in data) || (data.disciplineRecords is list && data.disciplineRecords.size() <= 50))
        && data.isDeleted is bool
        && isValidStr(data.createdAt, 64)
        && isValidStr(data.updatedAt, 64);
    }

    function isValidEmployee(data, instId) {
      return data.keys().hasAll(['institutionId', 'employeeCode', 'staffType', 'firstName', 'lastName', 'status', 'isDeleted', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['institutionId', 'employeeCode', 'staffType', 'category', 'firstName', 'lastName', 'photoUrl', 'email', 'phone', 'joiningDate', 'departmentId', 'designation', 'qualification', 'experienceYears', 'employmentType', 'assignedSubjectIds', 'assignedClassIds', 'salaryMonthly', 'userUid', 'status', 'isDeleted', 'createdAt', 'updatedAt'])
        && data.institutionId == instId
        && isNonEmptyStr(data.employeeCode, 48)
        && data.staffType in ['faculty', 'staff']
        && isValidOptStr(data, 'category', 80)
        && isNonEmptyStr(data.firstName, 80)
        && isNonEmptyStr(data.lastName, 80)
        && isValidOptStr(data, 'photoUrl', 400000)
        && isValidOptStr(data, 'email', 200)
        && isValidOptStr(data, 'phone', 30)
        && isValidOptStr(data, 'joiningDate', 20)
        && isValidOptStr(data, 'departmentId', 128)
        && isValidOptStr(data, 'designation', 100)
        && isValidOptStr(data, 'qualification', 160)
        && isValidOptNum(data, 'experienceYears')
        && (!( 'employmentType' in data) || data.employmentType in ['full_time', 'part_time', 'contract', 'visiting'])
        && (!( 'assignedSubjectIds' in data) || (data.assignedSubjectIds is list && data.assignedSubjectIds.size() <= 30))
        && (!( 'assignedClassIds' in data) || (data.assignedClassIds is list && data.assignedClassIds.size() <= 30))
        && isValidOptNum(data, 'salaryMonthly')
        && isValidOptStr(data, 'userUid', 128)
        && data.status in ['active', 'on_leave', 'inactive', 'resigned']
        && data.isDeleted is bool
        && isValidStr(data.createdAt, 64)
        && isValidStr(data.updatedAt, 64);
    }

    function isValidAttendance(data, instId) {
      return data.keys().hasAll(['institutionId', 'targetType', 'targetId', 'date', 'status', 'markedByUid', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['institutionId', 'academicYearId', 'targetType', 'targetId', 'targetName', 'studentUserUid', 'parentUserUid', 'classId', 'sectionId', 'subjectId', 'date', 'status', 'remarks', 'markedByUid', 'markedByName', 'createdAt', 'updatedAt'])
        && data.institutionId == instId
        && isValidOptStr(data, 'academicYearId', 128)
        && data.targetType in ['student', 'employee']
        && isNonEmptyStr(data.targetId, 128)
        && isValidOptStr(data, 'targetName', 160)
        && isValidOptStr(data, 'studentUserUid', 128)
        && isValidOptStr(data, 'parentUserUid', 128)
        && isValidOptStr(data, 'classId', 128)
        && isValidOptStr(data, 'sectionId', 128)
        && isValidOptStr(data, 'subjectId', 128)
        && isNonEmptyStr(data.date, 20)
        && data.status in ['present', 'absent', 'late', 'leave', 'holiday']
        && isValidOptStr(data, 'remarks', 300)
        && isNonEmptyStr(data.markedByUid, 128)
        && isValidOptStr(data, 'markedByName', 120)
        && isValidStr(data.createdAt, 64)
        && isValidStr(data.updatedAt, 64);
    }

    function isValidTimetableSlot(data, instId) {
      return data.keys().hasAll(['institutionId', 'classId', 'subjectId', 'dayOfWeek', 'startTime', 'endTime', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['institutionId', 'academicYearId', 'classId', 'sectionId', 'subjectId', 'subjectName', 'facultyId', 'facultyName', 'room', 'dayOfWeek', 'startTime', 'endTime', 'status', 'createdAt', 'updatedAt'])
        && data.institutionId == instId
        && isValidOptStr(data, 'academicYearId', 128)
        && isNonEmptyStr(data.classId, 128)
        && isValidOptStr(data, 'sectionId', 128)
        && isNonEmptyStr(data.subjectId, 128)
        && isValidOptStr(data, 'subjectName', 140)
        && isValidOptStr(data, 'facultyId', 128)
        && isValidOptStr(data, 'facultyName', 120)
        && isValidOptStr(data, 'room', 40)
        && data.dayOfWeek in ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday']
        && isNonEmptyStr(data.startTime, 10)
        && isNonEmptyStr(data.endTime, 10)
        && data.status in ['active', 'cancelled']
        && isValidStr(data.createdAt, 64)
        && isValidStr(data.updatedAt, 64);
    }

    function isValidExam(data, instId) {
      return data.keys().hasAll(['institutionId', 'name', 'examType', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['institutionId', 'academicYearId', 'name', 'examType', 'classId', 'programId', 'semesterNumber', 'startDate', 'endDate', 'enableRanking', 'status', 'subjects', 'createdAt', 'updatedAt'])
        && data.institutionId == instId
        && isValidOptStr(data, 'academicYearId', 128)
        && isNonEmptyStr(data.name, 140)
        && data.examType in ['internal', 'mid_term', 'semester', 'final', 'practical', 'viva']
        && isValidOptStr(data, 'classId', 128)
        && isValidOptStr(data, 'programId', 128)
        && isValidOptNum(data, 'semesterNumber')
        && isValidOptStr(data, 'startDate', 20)
        && isValidOptStr(data, 'endDate', 20)
        && isValidOptBool(data, 'enableRanking')
        && data.status in ['draft', 'scheduled', 'ongoing', 'completed', 'published']
        && (!( 'subjects' in data) || (data.subjects is list && data.subjects.size() <= 30))
        && isValidStr(data.createdAt, 64)
        && isValidStr(data.updatedAt, 64);
    }

    function isValidMark(data, instId) {
