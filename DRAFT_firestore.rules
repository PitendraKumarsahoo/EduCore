    function isValidMessage(data, instId) {
      return data.keys().hasAll(['institutionId', 'senderUid', 'subject', 'body', 'channel', 'createdAt'])
        && data.keys().hasOnly(['institutionId', 'senderUid', 'senderName', 'recipientUid', 'recipientName', 'targetAudience', 'subject', 'body', 'channel', 'isRead', 'createdAt'])
        && data.institutionId == instId
        && isNonEmptyStr(data.senderUid, 128)
        && isValidOptStr(data, 'senderName', 120)
        && isValidOptStr(data, 'recipientUid', 128)
        && isValidOptStr(data, 'recipientName', 120)
        && isValidOptStr(data, 'targetAudience', 60)
        && isNonEmptyStr(data.subject, 200)
        && isNonEmptyStr(data.body, 4000)
        && data.channel in ['in_app', 'email_queued', 'sms_queued']
