        && isNonEmptyStr(data.title, 160)
        && isNonEmptyStr(data.fileName, 200)
        && isValidOptStr(data, 'mimeType', 120)
        && isValidOptNum(data, 'sizeBytes')
        && isValidOptStr(data, 'dataUrl', 450000)
        && isValidOptBool(data, 'verified')
